#!/bin/bash
# Python virtual environment and package management functions powered by `uv` on Arch Linux.

export UV_PYTHON_INSTALL_DIR="/opt/uv-python"

# Ensures `uv` is installed and `/opt/uv-python` is world-readable for service accounts
function ensure_uv() {
    if ! command -v uv > /dev/null 2>&1; then
        pac_install uv
    fi
    mkdir -p "${UV_PYTHON_INSTALL_DIR}"
    chmod 755 "${UV_PYTHON_INSTALL_DIR}"
}
export -f ensure_uv

# Compatibility shim for legacy `pyenv_install` calls — now sets up `uv`
function pyenv_install() {
    ensure_uv
}
export -f pyenv_install

# Compatibility shim for legacy `pyenv_update` calls
function pyenv_update() {
    ensure_uv
}
export -f pyenv_update

# Installs a specific version of Python into `/opt/uv-python` via `uv`
# \
# Parameters:
# - `$1` = The Python version necessary (e.g. `3.11` or `3.11.3`)
function pyenv_install_version() {
    version=$1
    ensure_uv
    echo_progress_start "Ensuring Python ${version} is available via uv"
    UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv python install "${version}" >> "${log}" 2>&1
    chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}"
    echo_progress_done "Python ${version} ready"
}
export -f pyenv_install_version

# Creates a virtual environment of a specific Python version using `uv venv`
# \
# Parameters:
# - `$1` = The Python version necessary (e.g. `3.11`)
# - `$2` = Full path of the destination to create it in
function pyenv_create_venv() {
    version=$1
    destination=$2
    ensure_uv
    echo_progress_start "Creating uv venv (Python ${version}) in ${destination}"
    mkdir -p "$(dirname "${destination}")"
    UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv venv --seed --clear --python "${version}" "${destination}" >> "${log}" 2>&1
    chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}"
    echo_progress_done "venv created"
}
export -f pyenv_create_venv

# Creates a virtual environment in `/opt/.venv/<app>` using `uv venv`
# \
# Parameters:
# - `$1` = The user to chown the `venv` to
# - `$2` = The name of the app (`<app>`, creates `/opt/.venv/$2`)
# - `$3` = Optional Python version (defaults to `3.11` for maximum wheel & stdlib compatibility)
function python3_venv() {
    user=$1
    app=$2
    pyver="${3:-3.11}"
    ensure_uv
    echo_progress_start "Setting up the ${app} venv via uv (Python ${pyver})"
    mkdir -p /opt/.venv
    UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv venv --seed --clear --python "${pyver}" "/opt/.venv/${app}" >> "${log}" 2>&1
    chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}"
    chown -R "${user}": "/opt/.venv/${app}"
    echo_progress_done "Venv set up"
}
export -f python3_venv

# Installs packages or requirements into a venv using `uv pip install`
# \
# Parameters:
# - `$1` = Path to the virtual environment (e.g. `/opt/.venv/swizzin`) or its python binary
# - `$@` = Remaining arguments passed directly to `uv pip install`
function uv_pip_install() {
    venv_target=$1
    shift
    ensure_uv
    if [[ -d "${venv_target}" ]] && [[ -x "${venv_target}/bin/python" ]]; then
        py_bin="${venv_target}/bin/python"
    else
        py_bin="${venv_target}"
    fi
    UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv pip install --python "${py_bin}" "$@"
}
export -f uv_pip_install

# Legacy Python 2 shims (fallback to uv Python 3.11 if ever called)
function python_getpip() {
    ensure_uv
}
export -f python_getpip

function python2_venv() {
    python3_venv "$1" "$2"
}
export -f python2_venv

function python2_home_venv() {
    user=$1
    app=$2
    ensure_uv
    echo_progress_start "Setting up the ${app} venv via uv"
    mkdir -p "/home/${user}/.venv"
    UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv venv --seed --clear --python 3.11 "/home/${user}/.venv/${app}" >> "${log}" 2>&1
    chmod -R a+rX "${UV_PYTHON_INSTALL_DIR}"
    chown -R "${user}": "/home/${user}/.venv"
    echo_progress_done "Venv set up"
}
export -f python2_home_venv

# Checks if requirements are installed in `/opt/.venv/<app>`. Returns 1 if reqs missing.
# \
# Parameters:
# - `$1` = The name of the app to check the `venv` for
# - `$2` = The path to the `requirements.txt` to check against
function python3_check_reqs() {
    app=$1
    reqs_path=$2
    ensure_uv

    if UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR}" uv pip install --python "/opt/.venv/${app}/bin/python" -r "${reqs_path}" --dry-run >> "${log}" 2>&1; then
        return 0
    else
        return 1
    fi
}
export -f python3_check_reqs
