# SETUP.SH OPTIONS

## master user setup
user=test
pass=test123

## packages to install separated by colons.
packages=nginx:panel:transmission:letsencrypt


# PACKAGE SPECIFIC OPTIONS

## Deluge flags (Arch Linux uses the official repo package by default)
DELUGE_VERSION="repo"

## qBittorrent flags (Arch Linux uses the official repo package by default)
QBITTORRENT_VERSION="repo"

## transmission flags (Arch Linux uses the official repo package by default)
TRANSMISSION_VERSION="repo"

## rtorrent flags (Arch Linux uses the official repo package by default)
RTORRENT_VERSION="repo"

## LetsEncrypt options
LE_HOSTNAME="domain.tld"
LE_DEFAULTCONF=yes
# LE_BOOL_CF=no if you don't want to use Cloudflare DNS validation
LE_CF_API=aaapppiiiikkkeeeeeyyyyyyyy
LE_CF_EMAIL="email@example.com"
LE_CF_ZONE="some.zone.id" # or LE_CF_ZONEEXISTS=yes if you don't need it created
